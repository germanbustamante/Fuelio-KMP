root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = intellij_idea

# The codebase deliberately uses long lines for KDoc-heavy declarations and Compose call sites.
max_line_length = 140

# @Composable functions are PascalCase by convention, which ktlint's function-naming rule flags.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview

# Trailing commas are already the house style across every module.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Wildcard imports are never used here; keep it that way.
ktlint_standard_no-wildcard-imports = enabled

# Files are named after the concept they hold, not after their single declaration: the theme adapter
# is Color.kt/Spacing.kt/Shape.kt/Typography.kt mirroring the design-token files it adapts, and
# CLAUDE.md documents those names. Renaming them to FuelioSpacing.kt etc. would break that mapping.
ktlint_standard_filename = disabled

# ViewModels use the `_name` prefix for private plumbing flows that have no public counterpart on
# purpose: it marks "internal, never observed from Swift" as opposed to the `_state`/`state` pair that
# KMP-ObservableViewModel does expose. See the comment in GasStationsViewModel.
ktlint_standard_backing-property-naming = disabled

[core/presentation/src/commonMain/kotlin/com/germandebustamante/fuelio/core/designtokens/*.kt]
# Design tokens are SCREAMING_SNAKE_CASE `const val`s on purpose: that is the only shape
# Kotlin/Native exports as plain static constants Swift can read (see ADR 0003).
ktlint_standard_property-naming = disabled

[**/src/*Test/**/*.kt]
# Test method names are backtick-quoted GIVEN/WHEN/THEN sentences: they can't be wrapped, and
# shortening them would cost the description that makes a failing test readable.
ktlint_standard_function-naming = disabled
ktlint_standard_max-line-length = disabled

[androidApp/src/{test,androidTest}/**/*.kt]
ktlint_standard_function-naming = disabled
